{
  "permissions": {
    "allow": [
      "Bash(git push:*)",
      "Bash(ssh -T git@github.com -o BatchMode=yes -o ConnectTimeout=10)",
      "Bash(echo \"EXIT:$?\")",
      "Bash(curl -sI --connect-timeout 10 https://github.com)",
      "Bash(ssh -T -p 443 git@ssh.github.com -o BatchMode=yes -o ConnectTimeout=10)",
      "Bash(ssh -T git@github.com -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new)"
    ]
  }
}
