@JNEXT = [@MED join];
@JPREV = [@MED @INI @FIN @ISO join];
@PLAIN = [p p.ini p.fin p.iso b b.ini b.fin b.iso m m.ini m.fin m.iso f f.ini f.fin f.iso v v.ini v.fin v.iso w w.ini w.fin w.iso t t.ini t.fin t.iso d d.ini d.fin d.iso n n.ini n.fin n.iso th th.ini th.fin th.iso dh dh.ini dh.fin dh.iso s s.ini s.fin s.iso l l.ini l.fin l.iso r r.ini r.fin r.iso rh rh.ini rh.fin rh.iso k k.ini k.fin k.iso g g.ini g.fin g.iso h h.ini h.fin h.iso eng eng.ini eng.fin eng.iso hw hw.ini hw.fin hw.iso x x.ini x.fin x.iso a a.ini a.fin a.iso o o.ini o.fin o.iso u u.ini u.fin u.iso e e.ini e.fin e.iso i i.ini i.fin i.iso y y.ini y.fin y.iso aH aH.ini aH.fin aH.iso oH oH.ini oH.fin oH.iso];
