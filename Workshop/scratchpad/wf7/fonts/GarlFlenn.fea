@LOWER = [p b m f v w t d n s l r k g h a o u e i y x eng hw];
lookup HARM { lookupflag IgnoreMarks;
  sub @LOWER Acap' by aH; sub @LOWER Ocap' by oH;
} HARM;
lookup UCASE { sub @UC by @UCL; } UCASE;
table GDEF { GlyphClassDef , , @MARKS, ; } GDEF;
