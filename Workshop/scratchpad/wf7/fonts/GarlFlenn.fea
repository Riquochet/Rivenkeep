languagesystem DFLT dflt;
languagesystem latn dflt;
@LET = [p b m f v w t d n th dh s l r rh k g h eng hw x a o u e i y aH oH h.num p.num s.num g.num l.num v.num dh.num th.num r.num n.num d.num m.num b.num Acap Ocap];
@VOW = [a o u e i y aH oH Acap Ocap];
