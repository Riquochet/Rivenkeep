} FINA;
lookup INIT { lookupflag IgnoreMarks;
  ignore sub @JPREV @MED';
  ignore sub @JPREV @FIN';
  sub @MED' by @INI;
  sub @FIN' by @ISO;
} INIT;
lookup LINTEL { lookupflag IgnoreMarks;
  sub equal @PLAIN' by @PLAINLIN;
  sub @PLAINLIN @PLAIN' by @PLAINLIN;
} LINTEL;
